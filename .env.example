# Nikita Spa - Production Environment Variables
# Domain: https://nikita.online

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Google Tag Manager Container ID (optional, format: GTM-XXXXXXX)
VITE_GTM_ID=

# Google Search Console Verification Meta Tag Token (optional if verified via DNS/HTML file)
# Example: if your verification tag is <meta name="google-site-verification" content="abcdef12345" />, provide abcdef12345
VITE_GSC_VERIFICATION_TOKEN=
